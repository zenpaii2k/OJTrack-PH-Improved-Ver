// ══════════════════════════════════════════════════════════════════════
//  OJTrack PH — Corrected Firestore Security Rules
//  Audited against register.js + batchmanagement.js
//  Every changed rule has an inline explanation.
//  Deploy: firebase deploy --only firestore:rules
// ══════════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────
    // HELPERS
    // ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── FIX #1 (getRole) ─────────────────────────────────────────
    // ORIGINAL:
    //   function getRole() {
    //     return isAuth()
    //       ? get(/users/$(request.auth.uid)).data.role
    //       : null;
    //   }
    //
    // BUG: get() is called unconditionally on the user document.
    // During invite registration the sequence is:
    //   Step A → createUserWithEmailAndPassword()  → Auth exists
    //   Step B → setDoc(users/uid, payload)        → Firestore doc created
    //
    // Between A and B there is a real window (≥ one network round-trip)
    // where the Auth token is valid but the Firestore document does NOT
    // yet exist. If isStudent() or isAdviser() is evaluated during this
    // window — as happens inside the applyInvite() transaction — the
    // rules engine calls get() on a missing document, which throws an
    // uncaught exception → PERMISSION_DENIED.
    //
    // FIX: Guard every get() with exists() first.
    // If the document is absent, getRole() returns null safely.
    // isStudent() / isAdviser() return false without throwing.
    // ─────────────────────────────────────────────────────────────
    function getRole() {
      return (isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isStudent() {
      return isAuth() && getRole() == "student";
    }

    function isAdviser() {
      return isAuth() && getRole() == "supervisor";
    }


    // ══════════════════════════════════════════════════════════════
    // USERS  /users/{userId}
    // ══════════════════════════════════════════════════════════════
    match /users/{userId} {

      allow read: if isAuth();

      // register.js setDoc(users/uid, payload) — isSelf valid here
      // because createUserWithEmailAndPassword() has already resolved.
      allow create: if isSelf(userId);

      // Student updates their own profile (account.js, applyInvite step 6).
      // applyInvite tx.update(userRef, { batch, supervisorId, updatedAt })
      // — none of these are "role", so the role equality check passes.
      allow update: if isSelf(userId)
        && request.resource.data.role == resource.data.role;

      // ── FIX #2 (adviser clears student batch fields) ──────────
      // ORIGINAL: No adviser UPDATE path existed.
      //
      // BUG: batchmanagement.js removeStudent() calls:
      //   updateDoc(doc(db,"users",studentUid), { batch:"", supervisorId:"" })
      //   The adviser's UID ≠ studentUid → isSelf(studentUid) = FALSE
      //   → PERMISSION_DENIED on every student removal.
      //   The student's user doc retains stale batch/supervisorId values,
      //   causing their dashboard to show the old batch after removal.
      //
      // FIX: An adviser may update ONLY the three batch-assignment fields
      //   on any student document. Role, email, uid, createdAt are blocked.
      //
      // NOTE: batchmanagement.js originally wrote batch:"" (empty string).
      //   Empty strings break JS truthiness checks (userData.batch is falsy
      //   but typeof check passes). The fixed JS uses null; the rule allows
      //   both for backwards compatibility.
      // ─────────────────────────────────────────────────────────
      allow update: if isAdviser()
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['batch', 'supervisorId', 'updatedAt']);

      allow delete: if false;
    }


    // ══════════════════════════════════════════════════════════════
    // INVITATIONS  /invitations/{inviteId}
    // ══════════════════════════════════════════════════════════════
    match /invitations/{inviteId} {

      // ── FIX #3 (unauthenticated invite validation) ────────────
      // ORIGINAL:
      //   allow read: if isAuth();
      //
      // BUG: register.js DOMContentLoaded calls validateInvite(inviteId)
      //   which calls getDoc(invitations/inviteId).
      //
      //   The student has NO account yet. isAuth() = FALSE.
      //   → PERMISSION_DENIED immediately on page load.
      //   validateInvite() throws; the catch block disables the entire
      //   form: form.querySelectorAll("input,button").forEach(el => el.disabled=true)
      //   The student sees "Missing or insufficient permissions" and cannot
      //   proceed. inviteData stays null → applyInvite() returns early
      //   for every subsequent user too.
      //
      // NEW FLOW (post-fix): DOMContentLoaded also proactively checks
      //   if the invited email already has an account and shows the
      //   re-register modal BEFORE the student fills in the form.
      //   This getDoc must succeed without authentication.
      //
      // FIX: Split `allow read` into get (single doc) and list.
      //   Invite validation only ever fetches one document by ID.
      //   We allow that read publicly so new/returning users can
      //   validate the invite before or during registration.
      //   Listing all invites still requires authentication.
      // ─────────────────────────────────────────────────────────
      allow get:  if true;         // unauthenticated invite validation on page load
      allow list: if isAuth();     // listing invites requires auth (advisers)

      // batchmanagement.js generateInviteLink() → addDoc(invitations, {
      //   email, batchId, supervisorId: auth.currentUser.uid,
      //   status: "pending", createdAt, usedBy: null, usedAt: null
      // })
      // Rule checks supervisorId == request.auth.uid AND status == "pending".
      // Both match the payload exactly.
      allow create: if isAuth()
        && request.resource.data.supervisorId == request.auth.uid
        && request.resource.data.status == "pending";

      // Two update paths:
      // (a) Adviser edits or revokes their own invite.
      // (b) Student marks invite as used via applyInvite() tx.update(inviteRef, {
      //       status: "used", usedBy: uid, usedAt: serverTimestamp()
      //     })
      //     The student is authenticated at this point (just signed in or
      //     just created their account). The condition correctly checks the
      //     previous status was "pending" and the new status is "used".
      allow update: if isAuth() && (
        resource.data.supervisorId == request.auth.uid
        ||
        (
          resource.data.status == "pending"
          && request.resource.data.status == "used"
          && request.resource.data.usedBy == request.auth.uid
        )
      );
    }


    // ══════════════════════════════════════════════════════════════
    // BATCHES  /batches/{batchId}
    // ══════════════════════════════════════════════════════════════
    match /batches/{batchId} {

      allow read: if isAuth();

      // batchmanagement.js createNewBatch() → addDoc(batches, {
      //   supervisorId: auth.currentUser.uid, name, year,
      //   studentUids: [], createdAt: serverTimestamp()
      // })
      allow create: if isAdviser();

      // ── FIX #4 (student cannot join batch via invite) ─────────
      // ORIGINAL:
      //   allow update: if isAuth() && (
      //     resource.data.supervisorId == request.auth.uid || isAdviser()
      //   );
      //
      // BUG: applyInvite() transaction calls:
      //   tx.update(batchRef, { studentUids: arrayUnion(uid) })
      //   The auth user is the STUDENT (just registered or signed in).
      //   - resource.data.supervisorId is the adviser UID ≠ student UID → FALSE
      //   - isAdviser(): getRole() = "student" ≠ "supervisor"            → FALSE
      //   Both branches fail → PERMISSION_DENIED.
      //   The ENTIRE transaction rolls back. Invite is never marked used.
      //   Batch is never joined. Student user doc fields stay stale.
      //
      // FIX: Third update path — student joins batch via invite.
      //   Constraints enforced by the rule:
      //   1. Requester has student role.
      //   2. Only the studentUids field changes — nothing else.
      //   3. Existing UIDs are all still present (no removals).
      //   4. Array grows by 0 or 1 entries (>= handles arrayUnion
      //      idempotency when the student is already present — see
      //      Bug #5 note below).
      //
      // BUG #5 (also fixed here):
      //   applyInvite() had a conditional double-update on batchRef:
      //     if (batch.studentUids?.includes(uid)) {
      //       tx.update(batchRef, { studentUids: arrayRemove(uid) }); // write 1
      //     }
      //     tx.update(batchRef, { studentUids: arrayUnion(uid) });    // write 2
      //
      //   Firestore SDK collapses multiple tx.update() calls on the
      //   same document ref — only the LAST write applies. The arrayRemove
      //   is silently discarded. The fixed register.js removes the
      //   conditional arrayRemove entirely; arrayUnion is idempotent.
      //   The >= size check here handles both first-join (+1) and
      //   re-join (+0, UID already in array) cases.
      // ─────────────────────────────────────────────────────────
      allow update: if isAuth() && (
        resource.data.supervisorId == request.auth.uid
        ||
        isAdviser()
        ||
        (
          isStudent()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['studentUids'])
          && request.resource.data.studentUids.hasAll(resource.data.studentUids)
          && request.resource.data.studentUids.size()
              >= resource.data.studentUids.size()
        )
      );

      allow delete: if isAdviser()
        && resource.data.supervisorId == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    // ATTENDANCE  /attendance/{logId}
    // ══════════════════════════════════════════════════════════════
    match /attendance/{logId} {

      allow read: if isAuth();

      // ojtattendance.js addDoc writes: uid, timestamp, status:'Pending'
      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp == request.time;

      allow update: if isAuth();

      allow delete: if isAuth()
        && resource.data.uid == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    // CHECKLIST  /checklist/{docId}
    // ══════════════════════════════════════════════════════════════
    match /checklist/{docId} {

      allow read: if isAuth();

      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isAuth()
        && (resource.data.uid == request.auth.uid || isAdviser());

      allow delete: if isAuth()
        && resource.data.uid == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    // REPORTS  /reports/{reportId}
    // ══════════════════════════════════════════════════════════════
    match /reports/{reportId} {

      allow read: if isAuth();

      // generatepdf.js setDoc writes submittedAt: serverTimestamp()
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.submittedAt == request.time;

      allow update: if isAuth();

      allow delete: if false;
    }


    // ══════════════════════════════════════════════════════════════
    // NOTIFICATIONS  /notifications/{notifId}
    // ══════════════════════════════════════════════════════════════
    match /notifications/{notifId} {

      allow read: if isAuth()
        && resource.data.recipientUid == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.createdAt == request.time;

      allow update: if isAuth()
        && resource.data.recipientUid == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.recipientUid == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    // FEEDBACK  /students/{studentId}/feedback/{feedbackId}
    // ══════════════════════════════════════════════════════════════
    match /students/{studentId}/feedback/{feedbackId} {

      allow read: if isAuth()
        && (request.auth.uid == studentId || isAdviser());

      allow create: if isAuth();

      allow update: if isAuth()
        && request.auth.uid == studentId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['isRead'])
        && request.resource.data.isRead == true;

      allow delete: if true;
    }

  }
}
