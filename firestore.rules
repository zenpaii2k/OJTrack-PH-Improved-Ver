// ══════════════════════════════════════════════════════════════════════
//  OJTrack PH — Corrected Firestore Security Rules
//  All fixes derived from exact JS code audit of register.js +
//  batchmanagement.js.  Every changed rule is annotated.
//  Deploy: firebase deploy --only firestore:rules
// ══════════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────
    // HELPERS
    // ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── BUG #3 FIX ───────────────────────────────────────────────
    // ORIGINAL (broken):
    //   function getRole() {
    //     return isAuth()
    //       ? get(/users/$(request.auth.uid)).data.role
    //       : null;
    //   }
    //
    // WHY IT FAILS:
    //   get() is called on the user document without first checking
    //   exists(). Between createUserWithEmailAndPassword() completing
    //   and setDoc(users/uid) committing, the user document does not
    //   yet exist. Calling get() on a missing document causes the rules
    //   engine to throw an uncaught error → PERMISSION_DENIED, even
    //   though the user IS authenticated.
    //
    //   This window is small but real: any Firestore write inside
    //   applyInvite() that triggers isStudent() or isAdviser() can
    //   fail if the user document hasn't replicated yet.
    //
    // FIX: Guard the get() call with exists() first.
    //   If the document doesn't exist, return null safely.
    //   isStudent() / isAdviser() then return false without throwing.
    // ─────────────────────────────────────────────────────────────
    function getRole() {
      return (isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isStudent() {
      return isAuth() && getRole() == "student";
    }

    function isAdviser() {
      return isAuth() && getRole() == "supervisor";
    }


    // ══════════════════════════════════════════════════════════════
    // USERS  /users/{userId}
    // ══════════════════════════════════════════════════════════════
    match /users/{userId} {

      allow read: if isAuth();

      // Student creates their own document during registration.
      // register.js setDoc(users/uid, payload) — isSelf(uid) is valid
      // because createUserWithEmailAndPassword() has already completed.
      allow create: if isSelf(userId);

      // ── Student updates own profile ──────────────────────────
      // register.js applyInvite() → tx.update(userRef, { batch, supervisorId, updatedAt })
      // These fields don't include role, so the role-equality check passes.
      allow update: if isSelf(userId)
        && request.resource.data.role == resource.data.role;

      // ── BUG #4 FIX ──────────────────────────────────────────
      // ORIGINAL: No rule for adviser updating student documents.
      //
      // WHY IT FAILS:
      //   batchmanagement.js removeStudent() calls:
      //     updateDoc(doc(db, "users", studentUid), { batch: "", supervisorId: "" })
      //   The request.auth.uid is the ADVISER's UID.
      //   isSelf(studentUid) checks: adviserUid == studentUid → FALSE
      //   → PERMISSION_DENIED on every student removal.
      //   The student's batch/supervisorId fields are never cleared,
      //   causing stale data on the student dashboard after removal.
      //
      // FIX: Add an adviser update path that is strictly limited to
      //   the three batch-assignment fields only (batch, supervisorId,
      //   updatedAt). The adviser cannot touch role, email, uid,
      //   createdAt, or any other profile field.
      // ──────────────────────────────────────────────────────────
      allow update: if isAdviser()
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['batch', 'supervisorId', 'updatedAt']);

      allow delete: if false;
    }


    // ══════════════════════════════════════════════════════════════
    // INVITATIONS  /invitations/{inviteId}
    // ══════════════════════════════════════════════════════════════
    match /invitations/{inviteId} {

      // ── BUG #1 FIX ──────────────────────────────────────────
      // ORIGINAL:
      //   allow read: if isAuth();
      //
      // WHY IT FAILS:
      //   register.js DOMContentLoaded calls validateInvite(inviteId)
      //   which calls getDoc(invitations/inviteId).
      //
      //   At this point the user is UNAUTHENTICATED — they have no
      //   Firebase account yet. isAuth() = request.auth != null = FALSE.
      //   → PERMISSION_DENIED immediately on page load.
      //
      //   Because validateInvite() throws, the catch block runs:
      //     showBannerError(err.message)
      //     form.querySelectorAll("input, button").forEach(el => el.disabled = true)
      //   The student sees "Missing or insufficient permissions" and
      //   cannot proceed. inviteData stays null, so applyInvite() is
      //   also skipped for any user who somehow gets through.
      //
      // FIX: Separate read into get (single document) and list.
      //   Invite links only ever validate a single document by ID.
      //   We allow that one-doc read publicly (no auth required) so
      //   new users can verify the invite before registering.
      //   Listing all invites still requires authentication.
      // ──────────────────────────────────────────────────────────
      allow get:  if true;           // new users can validate before signing up
      allow list: if isAuth();       // listing requires auth (advisers only in practice)

      // batchmanagement.js generateInviteLink() → addDoc(invitations, {...})
      // Rule checks supervisorId == request.auth.uid AND status == "pending".
      // Both match the payload exactly.
      allow create: if isAuth()
        && request.resource.data.supervisorId == request.auth.uid
        && request.resource.data.status == "pending";

      // Two update paths:
      // (a) Adviser edits/revokes their own invite.
      // (b) Student marks invite as used — checked by register.js applyInvite()
      //     tx.update(inviteRef, { status:"used", usedBy:uid, usedAt:serverTimestamp() })
      //     The condition on line 3 in the original correctly allowed this
      //     path, so it is preserved unchanged.
      allow update: if isAuth() && (
        resource.data.supervisorId == request.auth.uid
        ||
        (
          resource.data.status == "pending"
          && request.resource.data.status == "used"
          && request.resource.data.usedBy == request.auth.uid
        )
      );
    }


    // ══════════════════════════════════════════════════════════════
    // BATCHES  /batches/{batchId}
    // ══════════════════════════════════════════════════════════════
    match /batches/{batchId} {

      allow read: if isAuth();

      // batchmanagement.js createNewBatch() → addDoc(batches, { supervisorId:uid, ... })
      allow create: if isAdviser();

      // ── BUG #2 FIX ──────────────────────────────────────────
      // ORIGINAL:
      //   allow update: if isAuth() && (
      //     resource.data.supervisorId == request.auth.uid || isAdviser()
      //   );
      //
      // WHY IT FAILS:
      //   register.js applyInvite() runs a transaction that includes:
      //     tx.update(batchRef, { studentUids: arrayUnion(uid) })
      //   The auth user at this point is the STUDENT, just registered.
      //   - resource.data.supervisorId is the ADVISER's UID ≠ student UID → FALSE
      //   - isAdviser(): getRole() returns "student" ≠ "supervisor"        → FALSE
      //   → PERMISSION_DENIED. The ENTIRE transaction rolls back.
      //   The invite is never marked as used. The batch is never joined.
      //
      // FIX: Add a third update path specifically for a student
      //   joining a batch via invite. The path enforces:
      //   1. The requester is a student (isStudent()).
      //   2. They are ONLY changing the studentUids field (nothing else).
      //   3. They are ADDING a UID — not removing or replacing.
      //      size() >= size() (not strictly +1) handles the re-join case
      //      where arrayUnion on an already-present UID leaves size unchanged.
      //   4. The existing UIDs are all preserved (no removals).
      //
      // NOTE on arrayUnion idempotency (Bug #5 interaction):
      //   register.js also had a conditional tx.update(arrayRemove) before
      //   the arrayUnion. Two tx.update() calls on the same doc in a
      //   transaction cause the second to override the first; the arrayRemove
      //   is effectively a no-op. The fix in register.js removes it entirely.
      //   Since arrayUnion is idempotent, the rules size() >= check handles
      //   both the first-time join (+1) and re-join (+0) cases.
      // ──────────────────────────────────────────────────────────
      allow update: if isAuth() && (
        resource.data.supervisorId == request.auth.uid
        ||
        isAdviser()
        ||
        (
          isStudent()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['studentUids'])
          && request.resource.data.studentUids.hasAll(resource.data.studentUids)
          && request.resource.data.studentUids.size()
              >= resource.data.studentUids.size()
        )
      );

      allow delete: if isAdviser()
        && resource.data.supervisorId == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    // ATTENDANCE  /attendance/{logId}
    // ══════════════════════════════════════════════════════════════
    match /attendance/{logId} {

      allow read: if isAuth();

      // ojtattendance.js addDoc writes: uid, timestamp, status:'Pending', ...
      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp == request.time;

      // Any authenticated user can update (adviser approves/rejects).
      // Tighten this if needed:
      //   allow update: if isAdviser();
      allow update: if isAuth();

      allow delete: if isAuth()
        && resource.data.uid == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    // CHECKLIST  /checklist/{docId}
    // ══════════════════════════════════════════════════════════════
    match /checklist/{docId} {

      allow read: if isAuth();

      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isAuth()
        && (resource.data.uid == request.auth.uid || isAdviser());

      allow delete: if isAuth()
        && resource.data.uid == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    // REPORTS  /reports/{reportId}
    // ══════════════════════════════════════════════════════════════
    match /reports/{reportId} {

      allow read: if isAuth();

      // generatepdf.js setDoc writes submittedAt: serverTimestamp()
      // (NOT createdAt) — the rule correctly uses submittedAt here.
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.submittedAt == request.time;

      allow update: if isAuth();

      allow delete: if false;
    }


    // ══════════════════════════════════════════════════════════════
    // NOTIFICATIONS  /notifications/{notifId}
    // ══════════════════════════════════════════════════════════════
    match /notifications/{notifId} {

      allow read: if isAuth()
        && resource.data.recipientUid == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.createdAt == request.time;

      allow update: if isAuth()
        && resource.data.recipientUid == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.recipientUid == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    // FEEDBACK  /students/{studentId}/feedback/{feedbackId}
    // ══════════════════════════════════════════════════════════════
    match /students/{studentId}/feedback/{feedbackId} {

      allow read: if isAuth()
        && (request.auth.uid == studentId || isAdviser());

      allow create: if isAuth();

      allow update: if isAuth()
        && request.auth.uid == studentId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['isRead'])
        && request.resource.data.isRead == true;

      // Tighten this if unintended deletes are a concern:
      //   allow delete: if isAdviser();
      allow delete: if true;
    }

  }
}
